ARG CHPL_VERSION
FROM chapel/chapel:${CHPL_VERSION}

ENV CHPL_COMM=gasnet
ENV CHPL_COMM_SUBSTRATE=ibv
ENV CHPL_LAUNCHER=gasnetrun_ibv

RUN apt-get update && apt-get install -y --no-install-recommends \
    rdma-core \
    libibmad5 \
    opensm \
    ibutils \
    infiniband-diags \
    perftest \
    mstflint \
    libibverbs1 \
    libibverbs-dev \
    librdmacm1 \
    libibumad3 \
    ibverbs-providers \
    rdmacm-utils \
    infiniband-diags \
    libfabric1 \
    ibverbs-utils

ARG MAKE_THREADS
RUN CHPL_TARGET_COMPILER=llvm make -j${MAKE_THREADS} -C $CHPL_HOME \
    && CHPL_TARGET_COMPILER=gnu make -j${MAKE_THREADS} -C $CHPL_HOME \
    && make -j${MAKE_THREADS} -C $CHPL_HOME chpldoc test-venv mason \
    && make -j${MAKE_THREADS} -C $CHPL_HOME cleanall
